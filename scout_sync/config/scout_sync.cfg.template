[COMMON]
log_file = scout_sync.log
timezone = Europe/Berlin

# web page title
title = Scouting 2024/25

# the port on which the app should listen
port = 8000

# timeout for requests to the schedules API
schedule_request_timeout = 20

# events cache file name
web_cache_file = events.json.cache

# CSV file with the leagues to read from the DBB schedule, relative to the config directory
schedule_leagues_file = schedule_leagues.csv

# Password for submitting from the webpage
submit_pw =

# calendar backend: google or caldav
calendar_backend = caldav

[GOOGLE_API]
# Google API authentication information (to be passed to google.oauth2 credentials)
oauth_info = 
service_account_info = 

[CALENDAR]
# Google Calendar ID
# dont use calendar id 'primary' with service account authentication
id =

[CALDAV]
# CalDAV server URL
url =
# Name of the calendar on the CalDAV server
calendar_name =
# Username for CalDAV authentication
username =
# Password for CalDAV authentication
password =

[SCAN_LEAGUES]
# DBB league list request parameters (JSON values) used for all teams
token = 0
verbandIds = []
ligatypIds = []

[SCAN_LEAGUES:Team name]
# teamPermanentId of the team and additional league list request parameters
teamPermanentId =
akgGeschlechtIds = []
altersklasseIds = []
spielklasseIds = []

[SCHEDULE_ARENAS]
# arena id = Name

[EMAILS]
# Name = e@mail.com

[SYNC_JOB]
# interval for updating the calender from the schedule in minutes
interval = 60

[SCAN_LEAGUES_JOB]
# interval for scanning the DBB database for new leagues of the teams in minutes
interval = 1440
